{
    "name": "@crustum/cake-logs-tui",
    "version": "0.1.0",
    "description": "CakePHP log TUI — OpenTUI host for bin/cake logs tui (Phase 2: fake-data shell)",
    "keywords": [
        "tui",
        "terminal",
        "cakephp",
        "logs",
        "opentui",
        "windows"
    ],
    "homepage": "https://github.com/Crustum/log-tui#readme",
    "license": "MIT",
    "type": "module",
    "bin": {
        "cake-logs-tui": "dist/cli.js"
    },
    "main": "dist/cli.js",
    "types": "dist/cli.d.ts",
    "exports": {
        ".": {
            "types": "./dist/cli.d.ts",
            "default": "./dist/cli.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "dev": "bun src/cli.ts --fake",
        "dev:node": "node --import tsx src/cli.ts --fake",
        "build": "tsc",
        "test": "bun test",
        "test:node": "node --test --import tsx src/**/*.test.ts",
        "check": "biome check --write",
        "lint": "biome lint",
        "format": "biome format --write",
        "prepublishOnly": "bun run build"
    },
    "dependencies": {
        "@opentui/core": "0.5.11",
        "commander": "^15.0.0"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.6",
        "@types/bun": "1.4.1",
        "@types/node": "^26.1.1",
        "tsx": "^4.23.5",
        "typescript": "^7.0.2"
    },
    "publishConfig": {
        "access": "public"
    },
    "os": [
        "darwin",
        "linux",
        "win32"
    ],
    "engines": {
        "bun": ">=1.3.0",
        "node": ">=26.4.0"
    }
}

{
    "$schema": "https://raw.githubusercontent.com/Crustum/log-tui/main/schemas/log-tui-theme.schema.json",
    "name": "dark",
    "defs": {
        "ink": "#09090b",
        "panel": "#18181b",
        "line": "#333333",
        "paper": "#d4d4d8",
        "muted": "#a1a1aa",
        "amber": "#e5c07b",
        "focusBlue": "#93c5fd",
        "softRed": "#ef4444"
    },
    "theme": {
        "background": "ink",
        "panel": "panel",
        "border": "line",
        "text": "paper",
        "dim": "muted",
        "accent": "amber",
        "focus": "focusBlue",
        "levels": {
            "debug": "#71717a",
            "info": "#93c5fd",
            "notice": "#86efac",
            "warning": "#fdba74",
            "error": "#fb7185",
            "critical": "softRed",
            "alert": "softRed",
            "emergency": "softRed"
        }
    }
}
